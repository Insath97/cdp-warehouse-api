{
	"info": {
		"_postman_id": "d98f7e2a-12ab-4bcd-8901-ef23456789ab",
		"name": "Database Export API Collection",
		"description": "Collection for CDP Warehouse API - Database Export Endpoint",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Export Database SQL Dump",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/v1/database/export",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"database",
						"export"
					]
				},
				"description": "Exports the MySQL database using mysqldump and returns the generated SQL file as a binary file download. Requires 'Database Export' permission."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://cdp-warehouse-api.test",
			"type": "string"
		},
		{
			"key": "token",
			"value": "YOUR_JWT_TOKEN_HERE",
			"type": "string"
		}
	]
}
